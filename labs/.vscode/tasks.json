{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "west build",
			"type" : "shell",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"linux": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"windows": {
				"command": "${config:zephyrVenv}/Scripts/west.exe"
			},
			"osx": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"args": ["build"],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "west pristine build",
			"type" : "shell",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"linux": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"windows": {
				"command": "${config:zephyrVenv}/Scripts/west.exe"
			},
			"osx": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"args": ["build", "-p", "-b", "${input:board}", "${workspaceFolder}/01_test"],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "west flash",
			"type": "shell",
			"linux": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"windows": {
				"command": "${config:zephyrVenv}/Scripts/west.exe"
			},
			"osx": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"args": [
				"flash"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label" : "dbgserver",
			"type" : "shell",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"isBackground": true,
			"linux": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"windows": {
				"command": "${config:zephyrVenv}/Scripts/west.exe"
			},
			"osx": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"args": [
				"build", "-t", "debugserver"
			],
			"problemMatcher": {
				"pattern": {
					"regexp": ".",
					"file": 1,"line": 1,
					"column": 1, "message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": { "regexp": "GDB server listening on port 3333"},
					"endsPattern": { "regexp": "." }
				}
			}
		},
		{
			"label" : "dbgserver qemu",
			"type" : "shell",
			"isBackground": true,
			"linux": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"windows": {
				"command": "${config:zephyrVenv}/Scripts/west.exe"
			},
			"osx": {
				"command": "${config:zephyrVenv}/bin/west"
			},
			"args": [
				"build", "-t", "debugserver_qemu"
			],
			"problemMatcher": {
				"pattern": {
					"regexp": "FATAL ERROR",
					"file": 1,"line": 1,
					"column": 1, "message": 1 
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": { "regexp": "To exit from QEMU enter"},
					"endsPattern": { "regexp": "." }
				}
			}
		},
		{
			"label": "stop dbgserver",
			"command": "echo ${input:terminate}",
			"type": "shell"
		}
	],
	"inputs": [
		{
			"id": "board",
			"type": "pickString",
			"description": "See https://docs.zephyrproject.org/latest/boards/index.html",
			"options": [
				"xmc47_relax_kit/xmc4700",
				"native_sim/native/64",
				"qemu_cortex_m3",
				"frdm_mcxn947/mcxn947/cpu0",
				"nrf52840dk/nrf52840"
			]
		},
		{
			"id": "terminate",
			"type": "command",
			"command": "workbench.action.tasks.terminate",
			"args": "terminateAll"
		},
	]
}